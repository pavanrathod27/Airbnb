<style>
  .btn-search {
    background-color: #fe424d;
    color: #fff;
    border-radius: 27px;
    padding: 0 1rem 0 1rem;
  }

  .btn-search:hover {
    background-color: #fe424d;
    color: #fff;
  }

  .btn-search i {
    display: inline;
    margin-right: 0.5rem;
  }

  .inp-search{
    border-radius: 27px;
    padding: 0.5rem 2.5rem 0.5rem 2.5rem;
  }

    @media (max-width: 767.98px) {
    .navbar-collapse {
      padding-bottom: 0.75rem;
    }
    .navbar-collapse form[role="search"] {
      width: 100%;
      margin: 0.5rem 0;
    }
    .navbar-collapse .nav-link {
      padding-top: 0.6rem;
      padding-bottom: 0.6rem;
    }
  }
</style>
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/"><i class="fa-solid fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search">
          <input class="form-control me-2 inp-search" type="search" placeholder="Search destinations" aria-label="Search">
          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
            
          </button>
        </form>
      </div>




      <div class="navbar-nav ms-auto">
        <a class="nav-link nav-hover" href="/listings/new">Add New Listing</a>
        <% if(!currUser) { %>
        <a class="nav-link nav-hover" aria-current="page" href="/signup"><b>Sign Up</b></a>
        <a class="nav-link nav-hover" href="/login"><b>Log-in</b></a>
        <% } %> <% if(currUser) { %>
        <a class="nav-link nav-hover" href="/logout"><b>Log-out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>